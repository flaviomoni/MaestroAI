# ==========================================
# Containerfile para Podman (Rootless / Multi-stage)
# ==========================================

# Etapa 1: Build da aplicação Java
FROM eclipse-temurin:21-jdk-alpine AS builder
WORKDIR /build

# Copia descritores de dependências
COPY pom.xml .
COPY src ./src

# Build do pacote JAR
RUN apk add --no-cache maven && \
    mvn clean package -DskipTests

# Etapa 2: Imagem final enxuta de execução
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

# Usuário sem privilégios (non-root)
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

# Copia o artefato compilado
COPY --from=builder /build/target/agent-orchestrator-*.jar app.jar

# Configurações de JVM e porta
ENV SERVER_PORT=8080
ENV JAVA_OPTS="-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8"

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
